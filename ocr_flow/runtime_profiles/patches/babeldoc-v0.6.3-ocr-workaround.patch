+    @staticmethod
+    def _preserve_source_raster(paragraph: PdfParagraph):
+        paragraph.box = None
+        paragraph.unicode = ""
+        paragraph.pdf_paragraph_composition = []
+
+    @staticmethod
+    def _is_noisy_ocr_margin_paragraph(
+        page: Page, paragraph: PdfParagraph
+    ) -> bool:
+        # Document IL uses PDF coordinates, so the bottom margin is near y=0.
+        if paragraph.box is None or paragraph.box.y > page.cropbox.box.y + 96.0:
+            return False
+        text = re.sub(r"\s+", "", paragraph.unicode or "")
+        if len(text) < 48:
+            return False
+        alphabetic = sum(character.isalpha() for character in text)
+        noisy = sum(
+            character.isdigit() or character in "/-_()$.,:"
+            for character in text
+        )
+        return alphabetic <= len(text) * 0.2 and noisy >= len(text) * 0.65
+
+    def _preserve_source_graphics_and_tables(self, page: Page):
+        """Leave OCR-backed graphics, tables, and margin noise in source raster."""
+        protected_boxes = [
+            layout.box
+            for layout in page.page_layout
+            if layout.box is not None
+            and layout.class_name
+            in {"figure", "table"}
+        ]
+        # Figure/table captions are semantic text. They use their layout boxes
+        # in add_text_fill_background so BabelDOC can mask and translate them.
+        for paragraph in page.pdf_paragraph:
+            if paragraph.box is None:
+                continue
+            if not any(
+                calculate_iou_for_boxes(paragraph.box, protected_box) >= 0.8
+                for protected_box in protected_boxes
+            ):
+                continue
+
+            # OCR often merges multiple table cells or plot labels into one
+            # paragraph. Masking and re-typesetting that fragment erases data;
+            # preserve the source raster instead.
+            self._preserve_source_raster(paragraph)
+
+        for paragraph in page.pdf_paragraph:
+            if self._is_noisy_ocr_margin_paragraph(page, paragraph):
+                # OCR text layers can contain binary-looking garbage that is
+                # absent from the page raster. Do not mask or re-typeset it.
+                self._preserve_source_raster(paragraph)
+
     def add_text_fill_background(self, page: Page):
